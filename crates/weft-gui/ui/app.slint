// The Weft window and its tray icon.

import { Theme, I18n, Icons, Utils } from "theme.slint";
import { Button, Dot } from "widgets.slint";
import { NetworkView, Notice, Welcome, Toast, UpdateBanner, MemberRow, NetworkCard } from "main.slint";
import {
    Chooser, Step, ServerRow, InviteRow, DeviceRow, CreateDialog, JoinDialog, SettingsDialog, ServersDialog,
    ServerMenuDialog, HostDialog, AddServerDialog, InvitesDialog, DevicesDialog, NetworkSettingsDialog,
    NetworkMenuDialog, MemberDialog, DiagnosticsDialog, NotificationsDialog,
} from "dialogs.slint";

export { Theme, I18n, Utils, Chooser, Step, ServerRow, InviteRow, DeviceRow, MemberRow, NetworkCard }

export component WeftTray inherits SystemTrayIcon {
    in property <string> open-text;
    in property <string> connect-text;
    in property <string> disconnect-text;
    in property <string> quit-text;
    callback open();
    callback connect();
    callback disconnect();
    callback quit();
    icon: @image-url("../icons/tray.png");
    tooltip: "Weft";
    title: "Weft";
    clicked => {
        root.open();
    }
    Menu {
        MenuItem {
            title: open-text;
            activated => {
                root.open();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: connect-text;
            activated => {
                root.connect();
            }
        }

        MenuItem {
            title: disconnect-text;
            activated => {
                root.disconnect();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: quit-text;
            activated => {
                root.quit();
            }
        }
    }
}

export component AppWindow inherits Window {
    // Main screen.
    in property <string> phase: "starting";
    in property <string> nickname;
    in-out property <string> welcome-nickname;
    in property <string> connection: "disconnected";
    in property <string> address;
    in property <[NetworkCard]> networks;
    in property <string> update-version;
    in property <string> update-stage;
    in property <int> update-progress;
    in property <bool> refreshing;
    in property <string> problem-title;
    in property <string> problem-text;
    in property <string> problem-action;
    in property <bool> problem-busy;
    in property <string> empty-text;
    in property <string> empty-hint;
    in property <string> toast-text;
    in property <bool> toast-error;
    in property <bool> toast-shown;

    // Dialogs: which one is open and what it shows.
    in property <string> dialog;
    in property <string> dialog-title;
    in property <string> dialog-error;
    in property <bool> dialog-busy;
    in-out property <string> settings-nickname;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <int> server-count;
    in-out property <bool> notifications;
    in property <string> notifications-detail;
    in property <[string]> notify-kinds;
    in property <[string]> notify-labels;
    in property <[bool]> notify-wanted;
    in-out property <bool> updates;
    in property <image> own-picture;
    in property <bool> own-has-picture;
    in property <int> own-tone;
    in property <string> own-initial;
    in property <[ServerRow]> servers;
    in property <bool> menu-local;
    in property <bool> menu-has-link;
    in property <bool> menu-has-panel;
    in-out property <string> host-address;
    in-out property <string> host-port;
    in property <string> list-network;
    in property <[InviteRow]> invites;
    in property <string> invite-created;
    in property <[string]> expiries;
    in property <string> devices-kind;
    in property <[DeviceRow]> devices;
    in property <bool> network-owner;
    in-out property <bool> network-locked;
    in-out property <bool> network-approval;
    in-out property <string> network-name;
    in property <bool> network-manager;
    in property <string> member-address;
    in property <bool> member-above;
    in property <bool> member-admin;
    in property <bool> member-muted;
    in property <string> member-muted-text;
    in property <[string]> mute-durations;
    in property <[string]> mute-units;
    in property <string> report;

    callback power();
    callback toggle-theme();
    callback open-settings();
    callback open-diagnostics();
    callback create();
    callback join();
    callback copy(string);
    callback toggle-network(int);
    callback network-invites(int);
    callback network-requests(int);
    callback network-menu(int);
    callback member-menu(int, int);
    callback member-ping(int, int);
    callback refresh();
    callback fix-problem();
    callback download-update();
    callback nickname-changed(string);
    callback dialog-leave();
    callback create-submit(string, string, string);
    callback join-submit(string, string);
    callback settings-save(string);
    callback language-chosen(int);
    callback open-servers();
    callback notifications-toggled(bool);
    callback open-notifications();
    callback notify-kind-toggled(string, bool);
    callback pick-picture();
    callback remove-picture();
    callback updates-toggled(bool);
    callback reset-app();
    callback server-menu(int);
    callback add-server();
    callback add-server-submit();
    callback host-settings();
    callback copy-server-link();
    callback open-panel();
    callback copy-panel-password();
    callback remove-server();
    callback host-save(string, string);
    callback invite-create(string, int);
    callback invite-revoke(string);
    callback device-act(string, string);
    callback network-configure(string, bool);
    callback network-password(string, string);
    callback network-rename(string);
    callback network-delete();
    callback network-pick(string);
    callback member-act(string);
    callback member-mute(int, string, int);
    callback report-refresh();
    callback report-save();

    title: "Weft";
    icon: @image-url("../icons/icon.png");
    preferred-width: 460px;
    preferred-height: 640px;
    min-width: 400px;
    min-height: 420px;
    background: Theme.bg;
    default-font-size: 13px;

    MenuBar {
        Menu {
            title: I18n.t("gui-menu-network");
            MenuItem {
                title: I18n.t(connection == "disconnected" ? "gui-connect" : "gui-disconnect");
                enabled: phase == "main";
                activated => {
                    root.power();
                }
            }

            MenuItem {
                title: I18n.t("gui-refresh");
                enabled: phase == "main";
                activated => {
                    root.refresh();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: I18n.t("gui-create-network") + "…";
                activated => {
                    root.create();
                }
            }

            MenuItem {
                title: I18n.t("gui-join-network") + "…";
                activated => {
                    root.join();
                }
            }
        }

        Menu {
            title: I18n.t("gui-menu-view");
            MenuItem {
                title: I18n.t(Theme.dark ? "gui-theme-light" : "gui-theme-dark");
                activated => {
                    root.toggle-theme();
                }
            }
        }

        Menu {
            title: I18n.t("gui-menu-tools");
            MenuItem {
                title: I18n.t("gui-settings") + "…";
                activated => {
                    root.open-settings();
                }
            }

            MenuItem {
                title: I18n.t("gui-diagnostics") + "…";
                activated => {
                    root.open-diagnostics();
                }
            }
        }
    }

    VerticalLayout {
        padding: 6px;
        padding-bottom: 0;
        spacing: 6px;
        if phase == "main" && update-version != "": UpdateBanner {
            version: update-version;
            stage: update-stage;
            progress: update-progress;
            download => {
                root.download-update();
            }
        }

        // Buttons are listed in reading order and reversed for right-to-left languages.
        if phase == "main": HorizontalLayout {
            spacing: 4px;
            alignment: I18n.rtl ? end : start;
            if I18n.rtl: Button {
                text: I18n.t("gui-join-network") + "…";
                clicked => {
                    root.join();
                }
            }
            if I18n.rtl: Button {
                text: I18n.t("gui-create-network") + "…";
                clicked => {
                    root.create();
                }
            }
            Button {
                text: I18n.t(connection == "disconnected" ? "gui-connect" : "gui-disconnect");
                enabled: connection != "connecting";
                clicked => {
                    root.power();
                }
            }

            if !I18n.rtl: Button {
                text: I18n.t("gui-create-network") + "…";
                clicked => {
                    root.create();
                }
            }
            if !I18n.rtl: Button {
                text: I18n.t("gui-join-network") + "…";
                clicked => {
                    root.join();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.line;
            Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-height: content.preferred-height;
                content := VerticalLayout {
                    alignment: start;
                    if phase == "starting": Notice {
                        title: I18n.t("gui-starting");
                        busy: true;
                    }
                    if phase == "problem": Notice {
                        title: problem-title;
                        text: problem-text;
                        action: problem-action;
                        action-busy: problem-busy;
                        act => {
                            root.fix-problem();
                        }
                    }
                    if phase == "welcome": Welcome {
                        nickname <=> root.welcome-nickname;
                        nickname-changed(name) => {
                            root.nickname-changed(name);
                        }
                        create => {
                            root.create();
                        }
                        join => {
                            root.join();
                        }
                    }
                    if phase == "main": VerticalLayout {
                        for network[i] in networks: NetworkView {
                            data: network;
                            toggle => {
                                root.toggle-network(i);
                            }
                            copy(text) => {
                                root.copy(text);
                            }
                            invites => {
                                root.network-invites(i);
                            }
                            requests => {
                                root.network-requests(i);
                            }
                            menu => {
                                root.network-menu(i);
                            }
                            member-menu(member) => {
                                root.member-menu(i, member);
                            }
                            member-ping(member) => {
                                root.member-ping(i, member);
                            }
                        }
                    }
                    if phase == "main" && networks.length == 0: Notice {
                        title: empty-text;
                        text: empty-hint;
                        action: connection == "disconnected" ? I18n.t("gui-connect") : "";
                        act => {
                            root.power();
                        }
                    }
                }
            }
        }

        // Status bar: connection state and address on the reading side, the nickname on the other.
        status := Rectangle {
            height: 22px;
            property <length> state-width: state-text.preferred-width + 14px;
            function place(start: length, size: length) -> length {
                return I18n.rtl ? self.width - start - size : start;
            }
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line-soft;
            }

            if phase == "main": Dot {
                x: status.place(2px, 8px);
                state: connection;
            }
            state-text := Text {
                x: status.place(phase == "main" ? 14px : 2px, self.width);
                text: phase == "main" ? I18n.t("state-" + connection) : phase == "starting" ? I18n.t("gui-starting") : "Weft";
                color: Theme.text;
                font-size: 12px;
            }

            if phase == "main" && address != "": Text {
                x: status.place(state-width + 10px, self.width);
                text: address;
                color: address-touch.has-hover ? Theme.accent : Theme.muted;
                font-family: "monospace";
                font-size: 12px;
                address-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.copy(address);
                    }
                }
            }
            if phase == "main": Text {
                x: I18n.rtl ? 2px : parent.width - self.width - 2px;
                width: min(self.preferred-width, parent.width / 3);
                text: nickname;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
    }

    Toast {
        width: min(self.preferred-width, root.width - 40px);
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 30px;
        text: toast-text;
        error: toast-error;
        shown: toast-shown;
    }

    if dialog == "create": CreateDialog {
        error: dialog-error;
        busy: dialog-busy;
        leave => {
            root.dialog-leave();
        }
        submit(name, password, repeat) => {
            root.create-submit(name, password, repeat);
        }
    }
    if dialog == "join": JoinDialog {
        error: dialog-error;
        busy: dialog-busy;
        leave => {
            root.dialog-leave();
        }
        submit(target, password) => {
            root.join-submit(target, password);
        }
    }
    if dialog == "settings": SettingsDialog {
        error: dialog-error;
        busy: dialog-busy;
        nickname <=> root.settings-nickname;
        languages: languages;
        language <=> root.language-index;
        servers: server-count;
        notifications-detail: notifications-detail;
        updates <=> root.updates;
        picture: own-picture;
        has-picture: own-has-picture;
        tone: own-tone;
        initial: own-initial;
        leave => {
            root.dialog-leave();
        }
        save(name) => {
            root.settings-save(name);
        }
        language-chosen(index) => {
            root.language-chosen(index);
        }
        open-servers => {
            root.open-servers();
        }
        open-notifications => {
            root.open-notifications();
        }
        pick-picture => {
            root.pick-picture();
        }
        remove-picture => {
            root.remove-picture();
        }
        updates-toggled(on) => {
            root.updates-toggled(on);
        }
        reset => {
            root.reset-app();
        }
    }
    if dialog == "notifications": NotificationsDialog {
        enabled <=> root.notifications;
        kinds: notify-kinds;
        labels: notify-labels;
        wanted: notify-wanted;
        leave => {
            root.dialog-leave();
        }
        enabled-toggled(on) => {
            root.notifications-toggled(on);
        }
        kind-toggled(kind, on) => {
            root.notify-kind-toggled(kind, on);
        }
    }
    if dialog == "servers": ServersDialog {
        error: dialog-error;
        servers: servers;
        leave => {
            root.dialog-leave();
        }
        menu(index) => {
            root.server-menu(index);
        }
        add => {
            root.add-server();
        }
    }
    if dialog == "server-menu": ServerMenuDialog {
        title: dialog-title;
        error: dialog-error;
        local: menu-local;
        has-link: menu-has-link;
        has-panel: menu-has-panel;
        open-panel => {
            root.open-panel();
        }
        copy-panel-password => {
            root.copy-panel-password();
        }
        leave => {
            root.dialog-leave();
        }
        host-settings => {
            root.host-settings();
        }
        copy-link => {
            root.copy-server-link();
        }
        remove => {
            root.remove-server();
        }
    }
    if dialog == "host": HostDialog {
        error: dialog-error;
        busy: dialog-busy;
        address <=> root.host-address;
        port <=> root.host-port;
        leave => {
            root.dialog-leave();
        }
        save(address, port) => {
            root.host-save(address, port);
        }
    }
    if dialog == "add-server": AddServerDialog {
        error: dialog-error;
        busy: dialog-busy;
        leave => {
            root.dialog-leave();
        }
        action => {
            root.add-server-submit();
        }
    }
    if dialog == "invites": InvitesDialog {
        error: dialog-error;
        busy: dialog-busy;
        network: list-network;
        invites: invites;
        created: invite-created;
        expiries: expiries;
        leave => {
            root.dialog-leave();
        }
        create(uses, expiry) => {
            root.invite-create(uses, expiry);
        }
        copy(text) => {
            root.copy(text);
        }
        revoke(code) => {
            root.invite-revoke(code);
        }
    }
    if dialog == "devices": DevicesDialog {
        error: dialog-error;
        kind: devices-kind;
        network: list-network;
        devices: devices;
        leave => {
            root.dialog-leave();
        }
        act(command, key) => {
            root.device-act(command, key);
        }
    }
    if dialog == "network-settings": NetworkSettingsDialog {
        error: dialog-error;
        owner: network-owner;
        locked <=> root.network-locked;
        approval <=> root.network-approval;
        name <=> root.network-name;
        busy: dialog-busy;
        rename(name) => {
            root.network-rename(name);
        }
        leave => {
            root.dialog-leave();
        }
        configure(key, on) => {
            root.network-configure(key, on);
        }
        change-password(password, repeat) => {
            root.network-password(password, repeat);
        }
        delete => {
            root.network-delete();
        }
    }
    if dialog == "network-menu": NetworkMenuDialog {
        title: dialog-title;
        error: dialog-error;
        manager: network-manager;
        leave => {
            root.dialog-leave();
        }
        pick(item) => {
            root.network-pick(item);
        }
    }
    if dialog == "member": MemberDialog {
        title: dialog-title;
        error: dialog-error;
        address: member-address;
        owner: network-owner;
        above: member-above;
        admin: member-admin;
        muted: member-muted;
        muted-text: member-muted-text;
        durations: mute-durations;
        units: mute-units;
        busy: dialog-busy;
        mute(duration, amount, unit) => {
            root.member-mute(duration, amount, unit);
        }
        leave => {
            root.dialog-leave();
        }
        act(command) => {
            root.member-act(command);
        }
    }
    if dialog == "diagnostics": DiagnosticsDialog {
        error: dialog-error;
        busy: dialog-busy;
        report: report;
        leave => {
            root.dialog-leave();
        }
        refresh => {
            root.report-refresh();
        }
        copy => {
            root.copy(report);
        }
        save => {
            root.report-save();
        }
    }
}
