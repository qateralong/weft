// The main screen: networks with their members as a tree, notices, the update note and short messages.

import { Theme, I18n, Icons } from "theme.slint";
import { Icon, IconButton, Button, Dot, Signal, Avatar, Tag, Spinner, ProgressBar, Field, Separator } from "widgets.slint";

export struct MemberRow {
    nickname: string,
    sub: string,
    address: string,
    dns: string,
    ping: string,
    level: int,
    link: string,
    tone: int,
    initial: string,
    me: bool,
    manageable: bool,
    badge: string,
    muted: bool,
    picture: image,
    has-picture: bool,
}

export struct NetworkCard {
    id: string,
    name: string,
    count: string,
    tags: [string],
    members: [MemberRow],
    collapsed: bool,
    requests: int,
    manager: bool,
}

// One member: presence, picture, name and how they are reached, address, ping. Placed by hand so it mirrors.
component MemberLine inherits Rectangle {
    in property <MemberRow> data;
    in property <bool> manager;
    callback copy(string);
    callback menu();
    callback ping();
    property <bool> pinging;
    height: 34px;
    background: touch.has-hover ? Theme.hover : transparent;
    property <length> pad: 6px;
    property <length> menu-width: 26px;
    property <length> signal-width: 72px;
    property <length> address-width: 96px;
    property <length> name-start: 22px + 20px + 8px;
    property <length> name-width: self.width - name-start - pad - menu-width - 6px - signal-width - address-width - 6px;

    function place(start: length, size: length) -> length {
        return I18n.rtl ? root.width - start - size : start;
    }

    touch := TouchArea { }

    Dot {
        x: place(pad + 2px, 8px);
        state: data.link;
    }

    Avatar {
        x: place(22px, 20px);
        initial: data.initial;
        tint: Theme.avatar(data.tone);
        link: data.link;
        picture: data.picture;
        has-picture: data.has-picture;
    }

    VerticalLayout {
        x: place(name-start, name-width);
        width: name-width;
        alignment: center;
        HorizontalLayout {
            alignment: I18n.rtl ? end : start;
            spacing: 5px;
            if data.me && I18n.rtl: Tag {
                text: "(" + I18n.t("gui-you") + ")";
            }
            if data.badge != "" && I18n.rtl: Tag {
                text: data.badge;
                strong: true;
            }
            name := Text {
                text: data.nickname;
                color: name-touch.has-hover && data.dns != "" ? Theme.accent : Theme.text;
                font-size: 13px;
                font-weight: data.me ? 700 : 400;
                overflow: elide;
                name-touch := TouchArea {
                    mouse-cursor: data.dns != "" ? pointer : default;
                    clicked => {
                        if data.dns != "" {
                            root.copy(data.dns);
                        }
                    }
                }
            }

            if data.badge != "" && !I18n.rtl: Tag {
                text: data.badge;
                strong: true;
            }
            if data.me && !I18n.rtl: Tag {
                text: "(" + I18n.t("gui-you") + ")";
            }
        }

        Text {
            text: data.sub;
            color: data.muted ? Theme.danger : Theme.muted;
            font-size: 11px;
            overflow: elide;
            horizontal-alignment: I18n.rtl ? right : left;
        }
    }

    Text {
        x: place(name-start + name-width + 6px, address-width);
        width: address-width;
        text: data.address;
        color: address-touch.has-hover ? Theme.accent : Theme.text;
        font-family: "monospace";
        font-size: 12px;
        horizontal-alignment: I18n.rtl ? right : left;
        address-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.copy(data.address);
            }
        }
    }

    Signal {
        x: place(root.width - pad - menu-width - 6px - signal-width, signal-width);
        level: data.level;
        ping: data.ping;
        busy: pinging;
    }

    TouchArea {
        x: place(root.width - pad - menu-width - 6px - signal-width, signal-width);
        width: signal-width;
        mouse-cursor: pointer;
        clicked => {
            pinging = true;
            root.ping();
        }
    }

    Timer {
        interval: 1500ms;
        running: pinging;
        triggered => {
            pinging = false;
        }
    }

    if data.manageable: IconButton {
        x: place(root.width - pad - menu-width, menu-width);
        width: menu-width;
        icon: Icons.more;
        clicked => {
            root.menu();
        }
    }

    Separator {
        y: parent.height - 1px;
    }
}

// The arrow that opens and closes a network.
component Expander inherits Icon {
    in property <bool> collapsed;
    width: 14px;
    height: 14px;
    name: Icons.chevron;
    stroke: Theme.muted;
    transform-rotation: collapsed ? (I18n.rtl ? 90deg : -90deg) : 0deg;
}

component NetworkTitle inherits HorizontalLayout {
    in property <NetworkCard> data;
    spacing: 6px;
    alignment: I18n.rtl ? end : start;
    if I18n.rtl: HorizontalLayout {
        spacing: 6px;
        for tag[i] in data.tags: Tag {
            text: tag;
            strong: i == data.tags.length - 1;
            overflow: elide;
        }
    }
    if I18n.rtl: Text {
        text: data.count;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
    }
    Text {
        text: data.name;
        color: Theme.text;
        font-size: 13px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }

    if !I18n.rtl: Text {
        text: data.count;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
    }
    if !I18n.rtl: HorizontalLayout {
        spacing: 6px;
        for tag[i] in data.tags: Tag {
            text: tag;
            strong: i == 0;
            overflow: elide;
        }
    }
}

export component NetworkView inherits Rectangle {
    in property <NetworkCard> data;
    callback toggle();
    callback copy(string);
    callback invites();
    callback requests();
    callback menu();
    callback member-menu(int);
    callback member-ping(int);
    property <length> head-height: 30px;
    property <length> row-height: 34px;
    height: head-height + (data.collapsed ? 0px : data.members.length * row-height);
    clip: true;

    head := Rectangle {
        y: 0;
        height: head-height;
        background: Theme.group;
        head-touch := TouchArea {
            clicked => {
                root.toggle();
            }
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 6px;
            // Children are listed in reading order and reversed for right-to-left languages.
            if !I18n.rtl: VerticalLayout {
                alignment: center;
                Expander {
                    collapsed: data.collapsed;
                }
            }
            if I18n.rtl: HorizontalLayout {
                spacing: 4px;
                padding-top: 3px;
                padding-bottom: 3px;
                IconButton {
                    icon: Icons.more;
                    tooltip: I18n.t("gui-network-settings");
                    clicked => {
                        root.menu();
                    }
                }

                if data.manager && data.requests > 0: Button {
                    small: true;
                    text: I18n.t("gui-requests") + " (" + data.requests + ")";
                    clicked => {
                        root.requests();
                    }
                }
            }
            NetworkTitle {
                horizontal-stretch: 1;
                data: data;
            }

            if !I18n.rtl: HorizontalLayout {
                spacing: 4px;
                padding-top: 3px;
                padding-bottom: 3px;
                if data.manager && data.requests > 0: Button {
                    small: true;
                    text: I18n.t("gui-requests") + " (" + data.requests + ")";
                    clicked => {
                        root.requests();
                    }
                }
                IconButton {
                    icon: Icons.more;
                    tooltip: I18n.t("gui-network-settings");
                    clicked => {
                        root.menu();
                    }
                }
            }
            if I18n.rtl: VerticalLayout {
                alignment: center;
                Expander {
                    collapsed: data.collapsed;
                }
            }
        }

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.line-soft;
        }
    }

    if !data.collapsed: VerticalLayout {
        y: head-height;
        height: data.members.length * row-height;
        for member[i] in data.members: MemberLine {
            data: member;
            manager: data.manager;
            copy(text) => {
                root.copy(text);
            }
            menu => {
                root.member-menu(i);
            }
            ping => {
                root.member-ping(i);
            }
        }
    }
}

export component Notice inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    in property <string> action;
    in property <bool> busy;
    in property <bool> action-busy;
    callback act();
    padding: 16px;
    spacing: 8px;
    Text {
        text: title;
        color: Theme.text;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if text != "": Text {
        text: root.text;
        color: Theme.muted;
        font-size: 13px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if busy: HorizontalLayout {
        alignment: center;
        Spinner { }
    }
    if action != "": HorizontalLayout {
        alignment: center;
        padding-top: 4px;
        Button {
            text: action;
            primary: true;
            enabled: !action-busy;
            clicked => {
                root.act();
            }
        }
    }
}

export component Welcome inherits VerticalLayout {
    in-out property <string> nickname;
    callback nickname-changed(string);
    callback create();
    callback join();
    padding: 16px;
    spacing: 8px;
    HorizontalLayout {
        spacing: 10px;
        alignment: I18n.rtl ? end : start;
        if !I18n.rtl: Image {
            source: @image-url("../icons/icon.png");
            width: 32px;
            height: 32px;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: I18n.t("gui-welcome");
                color: Theme.text;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: I18n.rtl ? right : left;
            }
        }

        if I18n.rtl: Image {
            source: @image-url("../icons/icon.png");
            width: 32px;
            height: 32px;
        }
    }

    Text {
        text: I18n.t("gui-welcome-hint");
        color: Theme.text;
        font-size: 13px;
        wrap: word-wrap;
        horizontal-alignment: I18n.rtl ? right : left;
    }

    Field {
        label: I18n.t("gui-nickname");
        text <=> root.nickname;
        accepted => {
            root.nickname-changed(self.text);
        }
    }

    HorizontalLayout {
        spacing: 6px;
        padding-top: 4px;
        alignment: I18n.rtl ? start : end;
        if I18n.rtl: Button {
            text: I18n.t("gui-join-network") + "…";
            primary: true;
            clicked => {
                root.nickname-changed(nickname);
                root.join();
            }
        }
        Button {
            text: I18n.t("gui-create-network") + "…";
            clicked => {
                root.nickname-changed(nickname);
                root.create();
            }
        }

        if !I18n.rtl: Button {
            text: I18n.t("gui-join-network") + "…";
            primary: true;
            clicked => {
                root.nickname-changed(nickname);
                root.join();
            }
        }
    }
}

// A short message in a yellow note, like a tooltip.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <bool> shown;
    visible: shown;
    height: label.preferred-height + 12px;
    border-radius: 4px;
    background: error ? Theme.danger-soft : Theme.note;
    border-width: 1px;
    border-color: error ? Theme.danger : Theme.note-line;
    label := Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: error ? Theme.danger : Theme.text;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
}

export component UpdateBanner inherits Rectangle {
    in property <string> version;
    // Empty while waiting, then "downloading" or "installing".
    in property <string> stage;
    in property <int> progress;
    callback download();
    height: 34px;
    border-radius: 4px;
    background: Theme.note;
    border-width: 1px;
    border-color: Theme.note-line;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 8px;
        if I18n.rtl && stage == "": VerticalLayout {
            alignment: center;
            Button {
                small: true;
                text: I18n.t("gui-update-install");
                clicked => {
                    root.download();
                }
            }
        }
        if I18n.rtl && stage == "downloading": VerticalLayout {
            alignment: center;
            ProgressBar {
                width: 100px;
                progress: progress;
            }
        }
        Text {
            text: stage == "downloading" ? I18n.ta("gui-update-downloading", "progress", progress)
                : stage == "installing" ? I18n.t("gui-update-installing")
                : I18n.ta("gui-update", "version", version);
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            horizontal-alignment: I18n.rtl ? right : left;
        }

        if !I18n.rtl && stage == "": VerticalLayout {
            alignment: center;
            Button {
                small: true;
                text: I18n.t("gui-update-install");
                clicked => {
                    root.download();
                }
            }
        }
        if !I18n.rtl && stage == "downloading": VerticalLayout {
            alignment: center;
            ProgressBar {
                width: 100px;
                progress: progress;
            }
        }
    }
}
