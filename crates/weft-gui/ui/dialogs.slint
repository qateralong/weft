// Dialogs over the main screen. Each one reports what the user entered through callbacks.

import { Theme, I18n, Icons, Utils } from "theme.slint";
import { Icon, IconButton, Button, DangerButton, Caption, Field, Switch, Select, MenuRow, Dot, Signal, ListBox, Separator, Avatar } from "widgets.slint";

export struct Step {
    label: string,
    state: string,
}

export struct ServerRow {
    kind: string,
    name: string,
    state: string,
    host: string,
    ping: string,
    level: int,
    note: string,
}

export struct InviteRow {
    code: string,
    link: string,
    details: string,
}

export struct DeviceRow {
    nickname: string,
    address: string,
    key: string,
}

// Where a new network lives: servers in use plus kinds not added yet, with SSH details when needed.
export global Chooser {
    in property <[string]> labels;
    in property <[string]> hints;
    in property <[bool]> needs-ssh;
    in-out property <int> index;
    in-out property <string> host;
    in-out property <string> user: "root";
    in-out property <string> password;
    in-out property <string> port: "22";
    in property <[Step]> steps;
    in property <bool> show-steps;
    out property <bool> ssh: index >= 0 && index < needs-ssh.length && needs-ssh[index];
}

// A bold heading over a group of controls, with a line running to the far side.
component Section inherits HorizontalLayout {
    in property <string> text;
    spacing: 6px;
    padding-top: 4px;
    if I18n.rtl: VerticalLayout {
        alignment: center;
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
    }
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        font-weight: 700;
        horizontal-stretch: 0;
    }

    if !I18n.rtl: VerticalLayout {
        alignment: center;
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
    }
}

// Keeps buttons at their own width on the reading side.
component Row inherits HorizontalLayout {
    alignment: I18n.rtl ? end : start;
    spacing: 6px;
}

component Paragraph inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
    horizontal-alignment: I18n.rtl ? right : left;
}

export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <string> error;
    in property <bool> busy;
    in property <string> leave-text: I18n.t("gui-cancel");
    in property <string> action-text;
    callback leave();
    callback action();
    background: Theme.backdrop;

    TouchArea { }

    card := Rectangle {
        width: min(400px, root.width - 24px);
        height: min(content.preferred-height + 2px, root.height - 24px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.card;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.shadow;

        keys := FocusScope {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.leave();
                    return accept;
                }
                return reject;
            }

            content := VerticalLayout {
                Rectangle {
                    height: 40px;
                    Text {
                        x: I18n.rtl ? 40px : 14px;
                        width: parent.width - 54px;
                        text: title != "" ? title : "Weft";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }

                    IconButton {
                        x: I18n.rtl ? 8px : parent.width - self.width - 8px;
                        icon: "M6 6l12 12 M18 6L6 18";
                        tooltip: leave-text;
                        clicked => {
                            root.leave();
                        }
                    }
                }

                VerticalLayout {
                    padding: 14px;
                    padding-top: 0;
                    spacing: 10px;
                    if error != "": Rectangle {
                        background: Theme.danger-soft;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.danger;
                        height: error-text.preferred-height + 10px;
                        error-text := Text {
                            x: 6px;
                            width: parent.width - 12px;
                            text: error;
                            color: Theme.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-alignment: I18n.rtl ? right : left;
                        }
                    }

                    Flickable {
                        preferred-height: body.preferred-height;
                        min-height: min(body.preferred-height, 60px);
                        content-height: body.preferred-height;
                        body := VerticalLayout {
                            // The card's own width, so wrapped text knows its lines before the layout runs.
                            width: card.width - 30px;
                            spacing: 10px;
                            @children
                        }
                    }

                    HorizontalLayout {
                        alignment: I18n.rtl ? start : end;
                        spacing: 6px;
                        padding-top: 4px;
                        if I18n.rtl: Button {
                            text: leave-text;
                            clicked => {
                                root.leave();
                            }
                        }
                        if action-text != "": Button {
                            text: action-text;
                            primary: true;
                            enabled: !root.busy;
                            clicked => {
                                root.action();
                            }
                        }
                        if !I18n.rtl: Button {
                            text: leave-text;
                            clicked => {
                                root.leave();
                            }
                        }
                    }
                }
            }
        }
    }
}

component StepLine inherits HorizontalLayout {
    in property <Step> step;
    spacing: 10px;
    alignment: I18n.rtl ? end : start;
    if I18n.rtl: Text {
        text: step.label;
        color: step.state == "failed" ? Theme.danger : step.state == "" ? Theme.muted : Theme.text;
    }
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 13px;
            height: 13px;
            border-width: 1px;
            border-color: step.state == "active" ? Theme.accent : Theme.line;
            background: step.state == "done" ? Theme.ok : step.state == "failed" ? Theme.danger
                : step.state == "active" ? Theme.accent-soft : Theme.field;
            if step.state == "done": Icon {
                width: 11px;
                height: 11px;
                name: Icons.check;
                stroke: white;
                stroke-width: 3.5px;
            }
        }
    }

    if !I18n.rtl: Text {
        text: step.label;
        color: step.state == "failed" ? Theme.danger : step.state == "" ? Theme.muted : Theme.text;
    }
}

export component ServerChooser inherits VerticalLayout {
    in property <string> caption: I18n.t("gui-server");
    spacing: 10px;
    VerticalLayout {
        spacing: 5px;
        Caption {
            text: caption;
        }

        Select {
            options: Chooser.labels;
            current <=> Chooser.index;
        }
    }

    if Chooser.index >= 0 && Chooser.index < Chooser.hints.length && Chooser.hints[Chooser.index] != "": Paragraph {
        text: Chooser.hints[Chooser.index];
    }
    if Chooser.ssh: VerticalLayout {
        spacing: 10px;
        Field {
            label: I18n.t("gui-vps-host");
            placeholder: "203.0.113.10";
            text <=> Chooser.host;
        }

        HorizontalLayout {
            spacing: 10px;
            Field {
                horizontal-stretch: 3;
                label: I18n.t("gui-vps-user");
                text <=> Chooser.user;
            }

            Field {
                horizontal-stretch: 1;
                label: I18n.t("gui-vps-port");
                text <=> Chooser.port;
            }
        }

        Field {
            label: I18n.t("gui-vps-password");
            password: true;
            text <=> Chooser.password;
        }
    }
    if Chooser.show-steps: Rectangle {
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.card;
        height: steps.preferred-height;
        steps := VerticalLayout {
            padding: 8px;
            spacing: 5px;
            for step in Chooser.steps: StepLine {
                step: step;
            }
        }
    }
}

export component CreateDialog inherits DialogFrame {
    callback submit(string, string, string);
    title: I18n.t("gui-create-network");
    action-text: I18n.t("gui-create");
    action => {
        root.submit(name.text, password.text, repeat.text);
    }
    name := Field {
        label: I18n.t("gui-network-name");
        accepted => {
            root.action();
        }
    }

    password := Field {
        label: I18n.t("gui-password");
        password: true;
        accepted => {
            root.action();
        }
    }

    repeat := Field {
        label: I18n.t("gui-password-repeat");
        password: true;
        accepted => {
            root.action();
        }
    }

    ServerChooser { }
}

export component JoinDialog inherits DialogFrame {
    callback submit(string, string);
    property <bool> by-link: Utils.is-link(target.text);
    property <string> secret;
    title: I18n.t("gui-join-network");
    action-text: I18n.t("gui-join");
    action => {
        root.submit(target.text, secret);
    }
    target := Field {
        label: I18n.t("gui-name-or-link");
        placeholder: "weft://…";
        accepted => {
            root.action();
        }
    }

    if !by-link: VerticalLayout {
        spacing: 12px;
        Field {
            label: I18n.t("gui-password");
            password: true;
            text <=> root.secret;
            accepted => {
                root.action();
            }
        }

        ServerChooser { }
    }
}

export component SettingsDialog inherits DialogFrame {
    in-out property <string> nickname;
    in property <[string]> languages;
    in-out property <int> language;
    in property <int> servers;
    in property <string> notifications-detail;
    in-out property <bool> updates;
    in property <image> picture;
    in property <bool> has-picture;
    in property <int> tone;
    in property <string> initial;
    callback save(string);
    callback language-chosen(int);
    callback open-servers();
    callback open-notifications();
    callback updates-toggled(bool);
    callback pick-picture();
    callback remove-picture();
    callback reset();
    title: I18n.t("gui-settings");
    action-text: I18n.t("gui-save");
    action => {
        root.save(nickname);
    }
    HorizontalLayout {
        spacing: 12px;
        alignment: I18n.rtl ? end : start;
        if !I18n.rtl: VerticalLayout {
            alignment: center;
            Avatar {
                width: 48px;
                height: 48px;
                initial: root.initial;
                tint: Theme.avatar(tone);
                picture: picture;
                has-picture: has-picture;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Caption {
                text: I18n.t("gui-picture");
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: I18n.rtl ? end : start;
                if has-picture && I18n.rtl: Button {
                    small: true;
                    text: I18n.t("gui-picture-remove");
                    clicked => {
                        root.remove-picture();
                    }
                }
                Button {
                    small: true;
                    text: I18n.t("gui-picture-choose") + "…";
                    enabled: !root.busy;
                    clicked => {
                        root.pick-picture();
                    }
                }

                if has-picture && !I18n.rtl: Button {
                    small: true;
                    text: I18n.t("gui-picture-remove");
                    clicked => {
                        root.remove-picture();
                    }
                }
            }
        }

        if I18n.rtl: VerticalLayout {
            alignment: center;
            Avatar {
                width: 48px;
                height: 48px;
                initial: root.initial;
                tint: Theme.avatar(tone);
                picture: picture;
                has-picture: has-picture;
            }
        }
    }

    Field {
        label: I18n.t("gui-nickname");
        text <=> root.nickname;
        accepted => {
            root.action();
        }
    }

    VerticalLayout {
        spacing: 5px;
        Caption {
            text: I18n.t("gui-language");
        }

        Select {
            options: languages;
            current <=> root.language;
            selected(index) => {
                root.language-chosen(index);
            }
        }
    }

    MenuRow {
        text: I18n.t("gui-servers");
        detail: servers;
        arrow: true;
        clicked => {
            root.open-servers();
        }
    }

    Section {
        text: I18n.t("gui-app");
    }

    MenuRow {
        text: I18n.t("gui-notifications");
        detail: notifications-detail;
        arrow: true;
        clicked => {
            root.open-notifications();
        }
    }

    Switch {
        text: I18n.t("gui-check-updates");
        checked <=> root.updates;
        toggled(on) => {
            root.updates-toggled(on);
        }
    }

    Section {
        text: I18n.t("gui-reset");
    }

    Paragraph {
        text: I18n.t("gui-reset-hint");
    }

    Row {
        DangerButton {
            text: I18n.t("gui-reset");
            confirmed => {
                root.reset();
            }
        }
    }
}

export component NotificationsDialog inherits DialogFrame {
    in-out property <bool> enabled;
    in property <[string]> kinds;
    in property <[string]> labels;
    in-out property <[bool]> wanted;
    callback enabled-toggled(bool);
    callback kind-toggled(string, bool);
    title: I18n.t("gui-notifications");
    leave-text: I18n.t("gui-back");
    Switch {
        text: I18n.t("gui-notifications-show");
        checked <=> root.enabled;
        toggled(on) => {
            root.enabled-toggled(on);
        }
    }

    Separator { }

    for kind[i] in kinds: Switch {
        text: labels[i];
        checked: wanted[i];
        enabled: root.enabled;
        toggled(on) => {
            root.kind-toggled(kind, on);
        }
    }
}

component ServerLine inherits Rectangle {
    in property <ServerRow> data;
    callback menu();
    height: line.preferred-height;
    property <length> pad: 6px;
    property <length> button-width: 26px;
    property <length> signal-width: 72px;
    property <length> text-width: self.width - 2 * pad - button-width - signal-width - 12px;

    // Positions inside the padded row.
    function place(start: length, size: length) -> length {
        return I18n.rtl ? root.width - 2 * pad - start - size : start;
    }

    line := VerticalLayout {
        padding: pad;
        spacing: 4px;
        Rectangle {
            height: 46px;
            VerticalLayout {
                x: place(0, text-width);
                width: text-width;
                alignment: center;
                spacing: 1px;
                Text {
                    text: data.name;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                    horizontal-alignment: I18n.rtl ? right : left;
                }

                HorizontalLayout {
                    spacing: 5px;
                    alignment: I18n.rtl ? end : start;
                    if !I18n.rtl: VerticalLayout {
                        alignment: center;
                        Dot {
                            state: data.state;
                        }
                    }
                    Text {
                        text: I18n.t("state-" + data.state);
                        color: Theme.text;
                        font-size: 12px;
                    }

                    if I18n.rtl: VerticalLayout {
                        alignment: center;
                        Dot {
                            state: data.state;
                        }
                    }
                }

                if data.host != "": Text {
                    text: data.host;
                    color: Theme.muted;
                    font-family: "monospace";
                    font-size: 12px;
                    overflow: elide;
                    horizontal-alignment: I18n.rtl ? right : left;
                }
            }

            Signal {
                x: place(root.width - 2 * pad - button-width - 6px - signal-width, signal-width);
                level: data.level;
                ping: data.ping;
            }

            IconButton {
                x: place(root.width - 2 * pad - button-width, button-width);
                width: button-width;
                icon: Icons.more;
                tooltip: I18n.t("gui-settings");
                clicked => {
                    root.menu();
                }
            }
        }

        if data.note != "": Paragraph {
            text: data.note;
        }
    }

    Separator {
        y: parent.height - 1px;
    }
}

export component ServersDialog inherits DialogFrame {
    in property <[ServerRow]> servers;
    callback menu(int);
    callback add();
    title: I18n.t("gui-servers");
    leave-text: I18n.t("gui-back");
    ListBox {
        for server[i] in servers: ServerLine {
            data: server;
            menu => {
                root.menu(i);
            }
        }
        if servers.length == 0: Rectangle {
            height: empty.preferred-height + 28px;
            empty := Paragraph {
                x: 14px;
                width: parent.width - 28px;
                text: I18n.t("gui-no-servers");
                horizontal-alignment: center;
            }
        }
    }

    Row {
        Button {
            text: I18n.t("gui-add-server");
            clicked => {
                root.add();
            }
        }
    }
}

export component ServerMenuDialog inherits DialogFrame {
    in property <bool> local;
    in property <bool> has-link;
    in property <bool> has-panel;
    callback host-settings();
    callback copy-link();
    callback open-panel();
    callback copy-panel-password();
    callback remove();
    leave-text: I18n.t("gui-back");
    if has-panel: MenuRow {
        text: I18n.t("gui-panel-open");
        arrow: true;
        clicked => {
            root.open-panel();
        }
    }
    if has-panel: MenuRow {
        text: I18n.t("gui-panel-password");
        clicked => {
            root.copy-panel-password();
        }
    }
    if local: MenuRow {
        text: I18n.t("gui-host-advanced");
        arrow: true;
        clicked => {
            root.host-settings();
        }
    }
    if has-link: MenuRow {
        text: I18n.t("gui-copy-server-link");
        clicked => {
            root.copy-link();
        }
    }
    Row {
        DangerButton {
            text: I18n.t(local ? "gui-host-stop" : "gui-server-remove");
            confirmed => {
                root.remove();
            }
        }
    }
}

export component HostDialog inherits DialogFrame {
    in-out property <string> address;
    in-out property <string> port;
    callback save(string, string);
    title: I18n.t("gui-host-advanced");
    leave-text: I18n.t("gui-back");
    action-text: I18n.t("gui-save");
    action => {
        root.save(address, port);
    }
    Paragraph {
        text: I18n.t("gui-host-advanced-hint");
    }

    Field {
        label: I18n.t("gui-host-address");
        placeholder: I18n.t("gui-host-address-auto");
        text <=> root.address;
    }

    Field {
        label: I18n.t("gui-host-port");
        text <=> root.port;
    }
}

export component AddServerDialog inherits DialogFrame {
    title: I18n.t("gui-add-server");
    leave-text: I18n.t("gui-back");
    action-text: I18n.t("gui-add");
    ServerChooser {
        caption: I18n.t("gui-server-kind");
    }
}

export component InvitesDialog inherits DialogFrame {
    in property <string> network;
    in property <[InviteRow]> invites;
    in property <string> created;
    in property <[string]> expiries;
    callback create(string, int);
    callback copy(string);
    callback revoke(string);
    property <int> expiry: 3;
    property <bool> limited;
    property <string> uses;
    leave-text: I18n.t("gui-close");
    title: I18n.t("gui-invites");
    Section {
        text: I18n.t("gui-new-invite");
    }

    Switch {
        text: I18n.t("gui-invite-limited");
        checked <=> root.limited;
    }

    if limited: uses := Field {
        label: I18n.t("gui-invite-uses");
        placeholder: "1";
        number: true;
        text <=> root.uses;
    }

    VerticalLayout {
        spacing: 5px;
        Caption {
            text: I18n.t("gui-invite-expiry");
        }

        Select {
            options: expiries;
            current <=> root.expiry;
        }
    }

    HorizontalLayout {
        alignment: I18n.rtl ? end : start;
        Button {
            text: I18n.t("gui-create");
            enabled: !root.busy;
            clicked => {
                root.create(limited ? uses : "", expiry);
            }
        }
    }

    if created != "": HorizontalLayout {
        spacing: 4px;
        if I18n.rtl: Button {
            text: I18n.t("gui-copy");
            clicked => {
                root.copy(created);
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 25px;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.line;
            TextInput {
                x: 5px;
                width: parent.width - 10px;
                text: created;
                read-only: true;
                single-line: true;
                color: Theme.text;
                font-family: "monospace";
                font-size: 12px;
                vertical-alignment: center;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.accent-text;
            }
        }

        if !I18n.rtl: Button {
            text: I18n.t("gui-copy");
            clicked => {
                root.copy(created);
            }
        }
    }
    Section {
        text: I18n.ta("invites-title", "name", network);
    }

    ListBox {
        for invite in invites: VerticalLayout {
            HorizontalLayout {
                padding: 5px;
                spacing: 4px;
                if I18n.rtl: VerticalLayout {
                    alignment: center;
                    Button {
                        small: true;
                        danger: true;
                        text: I18n.t("gui-revoke");
                        clicked => {
                            root.revoke(invite.code);
                        }
                    }
                }
                if I18n.rtl: VerticalLayout {
                    alignment: center;
                    Button {
                        small: true;
                        text: I18n.t("gui-copy");
                        clicked => {
                            root.copy(invite.link != "" ? invite.link : invite.code);
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: invite.code;
                        color: Theme.text;
                        font-family: "monospace";
                        font-size: 12px;
                        overflow: elide;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }

                    Text {
                        text: invite.details;
                        color: Theme.muted;
                        font-size: 11px;
                        overflow: elide;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }
                }

                if !I18n.rtl: VerticalLayout {
                    alignment: center;
                    Button {
                        small: true;
                        text: I18n.t("gui-copy");
                        clicked => {
                            root.copy(invite.link != "" ? invite.link : invite.code);
                        }
                    }
                }
                if !I18n.rtl: VerticalLayout {
                    alignment: center;
                    Button {
                        small: true;
                        danger: true;
                        text: I18n.t("gui-revoke");
                        clicked => {
                            root.revoke(invite.code);
                        }
                    }
                }
            }

            Separator { }
        }
        if invites.length == 0: Rectangle {
            height: 44px;
            Paragraph {
                text: I18n.ta("invites-empty", "name", network);
                horizontal-alignment: center;
            }
        }
    }
}

export component DevicesDialog inherits DialogFrame {
    in property <string> kind;
    in property <string> network;
    in property <[DeviceRow]> devices;
    callback act(string, string);
    leave-text: I18n.t("gui-close");
    title: I18n.t(kind == "requests" ? "gui-requests" : "gui-bans");
    ListBox {
        for device in devices: VerticalLayout {
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: device.nickname;
                        color: Theme.text;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }

                    Text {
                        text: device.address;
                        color: Theme.muted;
                        font-family: "monospace";
                        font-size: 12px;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }
                }

                if kind == "requests": VerticalLayout {
                    alignment: center;
                    Button {
                        small: true;
                        primary: true;
                        text: I18n.t("gui-approve");
                        clicked => {
                            root.act("approve", device.key);
                        }
                    }
                }
                if kind == "requests": VerticalLayout {
                    alignment: center;
                    Button {
                        small: true;
                        danger: true;
                        text: I18n.t("gui-deny");
                        clicked => {
                            root.act("deny", device.key);
                        }
                    }
                }
                if kind == "bans": VerticalLayout {
                    alignment: center;
                    Button {
                        small: true;
                        text: I18n.t("gui-unban");
                        clicked => {
                            root.act("unban", device.key);
                        }
                    }
                }
            }

            Separator { }
        }
        if devices.length == 0: Rectangle {
            height: 44px;
            Paragraph {
                text: I18n.ta(kind + "-empty", "name", network);
                horizontal-alignment: center;
            }
        }
    }
}

export component NetworkSettingsDialog inherits DialogFrame {
    in property <bool> owner;
    in-out property <bool> locked;
    in-out property <bool> approval;
    in-out property <string> name;
    callback configure(string, bool);
    callback change-password(string, string);
    callback rename(string);
    callback delete();
    leave-text: I18n.t("gui-close");
    title: I18n.t("gui-network-settings");
    if owner: VerticalLayout {
        spacing: 12px;
        Field {
            label: I18n.t("gui-network-name");
            text <=> root.name;
            accepted => {
                root.rename(root.name);
            }
        }

        Row {
            Button {
                text: I18n.t("gui-rename-network");
                enabled: !root.busy;
                clicked => {
                    root.rename(root.name);
                }
            }
        }

        Separator { }
    }
    Switch {
        text: I18n.t("gui-locked");
        checked <=> root.locked;
        toggled(on) => {
            root.configure("locked", on);
        }
    }

    Switch {
        text: I18n.t("gui-approval");
        checked <=> root.approval;
        toggled(on) => {
            root.configure("approval", on);
        }
    }

    if owner: VerticalLayout {
        spacing: 12px;
        Section {
            text: I18n.t("gui-change-password");
        }

        new-password := Field {
            label: I18n.t("gui-new-password");
            password: true;
        }

        repeat-password := Field {
            label: I18n.t("gui-password-repeat");
            password: true;
        }

        Row {
            Button {
                text: I18n.t("gui-change-password");
                clicked => {
                    root.change-password(new-password.text, repeat-password.text);
                    new-password.text = "";
                    repeat-password.text = "";
                }
            }
        }

        Section {
            text: I18n.t("gui-delete-network");
        }

        Row {
            DangerButton {
                text: I18n.t("gui-delete-network");
                confirmed => {
                    root.delete();
                }
            }
        }
    }
}

export component NetworkMenuDialog inherits DialogFrame {
    in property <bool> manager;
    callback pick(string);
    leave-text: I18n.t("gui-close");
    if manager: MenuRow {
        text: I18n.t("gui-invites");
        arrow: true;
        clicked => {
            root.pick("invites");
        }
    }
    if manager: MenuRow {
        text: I18n.t("gui-requests");
        arrow: true;
        clicked => {
            root.pick("requests");
        }
    }
    if manager: MenuRow {
        text: I18n.t("gui-bans");
        arrow: true;
        clicked => {
            root.pick("bans");
        }
    }
    if manager: MenuRow {
        text: I18n.t("gui-network-settings");
        arrow: true;
        clicked => {
            root.pick("settings");
        }
    }
    Row {
        DangerButton {
            text: I18n.t("gui-leave");
            confirmed => {
                root.pick("leave");
            }
        }
    }
}

export component MemberDialog inherits DialogFrame {
    in property <string> address;
    // Whether this device owns the network and may change roles.
    in property <bool> owner;
    // Whether this device ranks above the member and may remove or mute them.
    in property <bool> above;
    in property <bool> admin;
    in property <bool> muted;
    in property <string> muted-text;
    in property <[string]> durations;
    in property <[string]> units;
    callback act(string);
    callback mute(int, string, int);
    property <int> duration: 0;
    property <int> unit: 0;
    property <string> amount;
    property <bool> custom: duration == durations.length - 2;
    leave-text: I18n.t("gui-close");
    Text {
        text: address;
        color: Theme.muted;
        font-family: "monospace";
        horizontal-alignment: I18n.rtl ? right : left;
    }

    if owner && !admin: Row {
        Button {
            text: I18n.t("gui-promote");
            clicked => {
                root.act("promote");
            }
        }
    }
    if owner && admin: Row {
        Button {
            text: I18n.t("gui-demote");
            clicked => {
                root.act("demote");
            }
        }
    }
    if above: Section {
        text: I18n.t("gui-mute");
    }
    if above && muted: Paragraph {
        text: muted-text;
        color: Theme.danger;
    }
    if above && muted: Row {
        Button {
            text: I18n.t("gui-unmute");
            enabled: !root.busy;
            clicked => {
                root.act("unmute");
            }
        }
    }
    if above && !muted: Paragraph {
        text: I18n.t("gui-mute-hint");
    }
    if above && !muted: HorizontalLayout {
        spacing: 8px;
        if I18n.rtl: Button {
            text: I18n.t("gui-mute-action");
            enabled: !root.busy;
            clicked => {
                root.mute(duration, amount, unit);
            }
        }
        Select {
            horizontal-stretch: 1;
            options: durations;
            current <=> root.duration;
        }

        if !I18n.rtl: Button {
            text: I18n.t("gui-mute-action");
            enabled: !root.busy;
            clicked => {
                root.mute(duration, amount, unit);
            }
        }
    }
    if above && !muted && custom: HorizontalLayout {
        spacing: 10px;
        Field {
            horizontal-stretch: 1;
            placeholder: "10";
            number: true;
            text <=> root.amount;
        }

        Select {
            horizontal-stretch: 1;
            options: units;
            current <=> root.unit;
        }
    }
    if above: Separator { }
    if above: HorizontalLayout {
        spacing: 8px;
        Button {
            horizontal-stretch: 1;
            danger: true;
            text: I18n.t("gui-kick");
            clicked => {
                root.act("kick");
            }
        }

        DangerButton {
            horizontal-stretch: 1;
            text: I18n.t("gui-ban");
            confirmed => {
                root.act("ban");
            }
        }
    }
}

export component DiagnosticsDialog inherits DialogFrame {
    in property <string> report;
    callback refresh();
    callback copy();
    callback save();
    leave-text: I18n.t("gui-close");
    title: I18n.t("gui-diagnostics");
    Rectangle {
        height: min(report-text.preferred-height + 12px, 360px);
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.card;
        Flickable {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            content-height: report-text.preferred-height;
            report-text := TextInput {
                width: parent.width;
                text: report;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                color: Theme.text;
                font-family: "monospace";
                font-size: 12px;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.accent-text;
            }
        }
    }

    Row {
        Button {
            text: I18n.t("gui-refresh");
            enabled: !root.busy;
            clicked => {
                root.refresh();
            }
        }

        Button {
            text: I18n.t("gui-copy");
            clicked => {
                root.copy();
            }
        }

        Button {
            text: I18n.t("gui-save-report") + "…";
            clicked => {
                root.save();
            }
        }
    }
}
