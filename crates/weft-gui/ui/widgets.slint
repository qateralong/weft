// Plain widgets in the look of an ordinary desktop toolkit: square frames, gray buttons, no motion.

import { Theme, I18n, Icons } from "theme.slint";

export component Icon inherits Path {
    in property <string> name;
    commands: name;
    width: 14px;
    height: 14px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke-width: 2px;
    stroke-line-cap: square;
    stroke-line-join: miter;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> small;
    in property <bool> enabled: true;
    callback clicked();
    height: small ? 22px : 25px;
    min-width: max(small ? 0px : 80px, label.preferred-width + (small ? 14px : 20px));
    horizontal-stretch: 0;
    border-radius: 2px;
    border-width: 1px;
    border-color: !enabled ? Theme.line-soft : primary || touch.has-hover ? Theme.accent : Theme.line;
    background: touch.pressed && enabled ? Theme.button-pressed
        : @linear-gradient(180deg, Theme.button-top 0%, Theme.button-bottom 100%);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => {
        root.clicked();
    }
    // The default button of a dialog gets a second frame line.
    if primary && enabled: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.35);
    }
    label := Text {
        x: (parent.width - self.width) / 2 + (touch.pressed && enabled ? 1px : 0px);
        y: (parent.height - self.height) / 2 + (touch.pressed && enabled ? 1px : 0px);
        text: root.text;
        color: !enabled ? Theme.muted : danger ? Theme.danger : Theme.text;
        font-size: small ? 12px : 13px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Asks for a second click within four seconds before doing something that cannot be undone.
export component DangerButton inherits Rectangle {
    in property <string> text;
    in property <bool> small;
    callback confirmed();
    property <bool> armed;
    height: small ? 22px : 25px;
    min-width: max(80px, label.preferred-width + 20px);
    horizontal-stretch: 0;
    border-radius: 2px;
    border-width: 1px;
    border-color: armed || touch.has-hover ? Theme.danger : Theme.line;
    background: armed ? Theme.danger
        : touch.pressed ? Theme.button-pressed
        : @linear-gradient(180deg, Theme.button-top 0%, Theme.button-bottom 100%);
    accessible-role: button;
    accessible-label: label.text;
    label := Text {
        text: armed ? I18n.t("gui-confirm") : root.text;
        color: armed ? white : Theme.danger;
        font-size: small ? 12px : 13px;
        font-weight: armed ? 700 : 400;
    }

    touch := TouchArea {
        clicked => {
            if armed {
                armed = false;
                root.confirmed();
            } else {
                armed = true;
            }
        }
    }

    Timer {
        interval: 4s;
        running: armed;
        triggered => {
            armed = false;
        }
    }
}

export component Caption inherits Text {
    color: Theme.text;
    font-size: 12px;
    horizontal-alignment: I18n.rtl ? right : left;
}

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> number;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback accepted();
    callback edited(string);
    forward-focus: input;
    spacing: 3px;
    if label != "": Caption {
        text: label;
    }
    Rectangle {
        height: 24px;
        background: enabled ? Theme.field : Theme.bg;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.line;
        clip: true;
        if text == "" && !input.has-focus: Text {
            x: 5px;
            width: parent.width - 10px;
            text: placeholder;
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: I18n.rtl ? right : left;
        }
        input := TextInput {
            x: 5px;
            width: parent.width - 10px;
            text <=> root.text;
            enabled: root.enabled;
            color: Theme.text;
            font-size: 13px;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-text;
            input-type: password ? InputType.password : number ? InputType.number : InputType.text;
            single-line: true;
            vertical-alignment: center;
            horizontal-alignment: I18n.rtl ? right : left;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited(self.text);
            }
        }
    }
}

// A check box with its label; named after the switch it replaced.
export component Switch inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: max(18px, label.preferred-height);
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: text;
    function flip() {
        checked = !checked;
        root.toggled(checked);
    }
    box := Rectangle {
        x: I18n.rtl ? parent.width - 13px : 0;
        y: (parent.height - 13px) / 2;
        width: 13px;
        height: 13px;
        background: enabled ? (touch.pressed ? Theme.button-pressed : Theme.field) : Theme.bg;
        border-width: 1px;
        border-color: touch.has-hover && enabled ? Theme.accent : Theme.line;
        if checked: Icon {
            width: 11px;
            height: 11px;
            name: Icons.check;
            stroke: enabled ? Theme.text : Theme.muted;
            stroke-width: 3.5px;
        }
    }

    label := Text {
        x: I18n.rtl ? 0 : 20px;
        width: parent.width - 20px;
        text: root.text;
        color: enabled ? Theme.text : Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: I18n.rtl ? right : left;
        wrap: word-wrap;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            flip();
        }
    }
}

// A small arrow pointing down, drawn rather than taken from a font.
component Arrow inherits Path {
    width: 7px;
    height: 4px;
    commands: "M0 0 L7 0 L3.5 4 Z";
    stroke-width: 0;
}

export component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback selected(int);
    height: 24px;
    background: Theme.field;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.line;
    accessible-role: combobox;
    accessible-value: current >= 0 && current < options.length ? options[current] : "";
    Text {
        x: I18n.rtl ? 22px : 5px;
        width: parent.width - 28px;
        text: current >= 0 && current < options.length ? options[current] : "";
        color: Theme.text;
        font-size: 13px;
        overflow: elide;
        horizontal-alignment: I18n.rtl ? right : left;
    }

    Rectangle {
        x: I18n.rtl ? 1px : parent.width - 18px;
        y: 1px;
        width: 17px;
        height: parent.height - 2px;
        background: touch.pressed ? Theme.button-pressed : @linear-gradient(180deg, Theme.button-top 0%, Theme.button-bottom 100%);
        Rectangle {
            x: I18n.rtl ? parent.width - 1px : 0;
            width: 1px;
            background: Theme.line-soft;
        }

        Arrow {
            fill: Theme.text;
        }
    }

    touch := TouchArea {
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height - 1px;
        width: root.width;
        Rectangle {
            background: Theme.field;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.7);
            VerticalLayout {
                padding: 1px;
                for option[i] in options: Rectangle {
                    height: 20px;
                    background: option-touch.has-hover ? Theme.accent : i == current ? Theme.accent-soft : transparent;
                    Text {
                        x: 5px;
                        width: parent.width - 10px;
                        text: option;
                        font-size: 13px;
                        color: option-touch.has-hover ? Theme.accent-text : Theme.text;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }

                    option-touch := TouchArea {
                        clicked => {
                            current = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

// A button that opens another dialog; the dots say so, as in menus.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> danger;
    in property <bool> arrow;
    callback clicked();
    height: 25px;
    border-radius: 2px;
    border-width: 1px;
    border-color: touch.has-hover ? (danger ? Theme.danger : Theme.accent) : Theme.line;
    background: touch.pressed ? Theme.button-pressed : @linear-gradient(180deg, Theme.button-top 0%, Theme.button-bottom 100%);
    accessible-role: button;
    accessible-label: text;
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text + (arrow ? "…" : "");
        color: danger ? Theme.danger : Theme.text;
        font-size: 13px;
        horizontal-alignment: I18n.rtl ? right : left;
    }

    if detail != "": Text {
        x: I18n.rtl ? 8px : parent.width - self.width - 8px;
        text: detail;
        color: Theme.muted;
        font-size: 12px;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Dot inherits Rectangle {
    in property <string> state;
    width: 8px;
    height: 8px;
    border-radius: self.width / 2;
    background: Theme.state-color(state);
    border-width: 1px;
    border-color: Theme.state-color(state).darker(0.3);
}

// Four bars and the round trip next to them; the bars grow from left to right in every language.
export component Signal inherits Rectangle {
    in property <int> level;
    in property <string> ping;
    in property <string> tooltip;
    // Grays the numbers while the ping is measured again.
    in property <bool> busy;
    width: 72px;
    height: 16px;
    accessible-role: text;
    accessible-label: ping;
    for bar[i] in [1, 2, 3, 4]: Rectangle {
        x: i * 4px;
        y: parent.height - 3px - bar * 3px;
        width: 3px;
        height: 3px + bar * 3px;
        background: bar > level ? Theme.line-soft : level >= 3 ? Theme.ok : level == 2 ? Theme.warn : Theme.danger;
    }
    Text {
        x: 20px;
        width: parent.width - 20px;
        text: ping;
        color: busy ? Theme.line : Theme.muted;
        font-size: 12px;
        horizontal-alignment: left;
    }
}

export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <string> link;
    in property <image> picture;
    in property <bool> has-picture;
    // Kept for callers that used to hide the presence mark.
    in property <bool> plain;
    width: 20px;
    height: 20px;
    background: tint;
    border-width: 1px;
    border-color: Theme.line;
    if !has-picture: Text {
        text: initial;
        color: white;
        font-weight: 700;
        font-size: root.height * 0.55;
    }
    if has-picture: Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: picture;
        image-fit: cover;
    }
}

export component Tag inherits Text {
    in property <bool> strong;
    color: strong ? Theme.accent : Theme.muted;
    font-size: 11px;
    vertical-alignment: center;
}

// An endless progress bar for work of unknown length.
export component Spinner inherits Rectangle {
    width: 140px;
    height: 12px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    property <float> phase: Math.mod(animation-tick() / 1ms, 1600) / 1600;
    property <float> span: root.width / 1px + 40;
    for i in [0, 1, 2, 3]: Rectangle {
        x: (Math.mod(phase * span + i * 9, span) - 40) * 1px;
        y: 2px;
        width: 7px;
        height: parent.height - 4px;
        background: Theme.accent;
    }
}

export component ProgressBar inherits Rectangle {
    in property <int> progress;
    height: 14px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;
    Rectangle {
        x: I18n.rtl ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: (parent.width - 4px) * max(0, min(100, progress)) / 100;
        height: parent.height - 4px;
        background: Theme.accent;
    }
}

// A white list in a sunken frame.
export component ListBox inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 1px;
        @children
    }
}

export component Separator inherits Rectangle {
    height: 1px;
    background: Theme.line-soft;
}
