// Plain widgets in the look of an ordinary desktop toolkit: flat buttons, thin frames, no motion.

import { Theme, I18n, Icons } from "theme.slint";

export component Icon inherits Path {
    in property <string> name;
    commands: name;
    width: 16px;
    height: 16px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// A flat button with only an icon; it shows its background while hovered.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <color> tint: Theme.muted;
    callback clicked();
    width: 26px;
    height: 24px;
    border-radius: 4px;
    background: touch.pressed ? Theme.button-pressed : touch.has-hover ? Theme.button-hover : transparent;
    accessible-role: button;
    accessible-label: tooltip;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        name: icon;
        stroke: touch.has-hover ? Theme.text : tint;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> small;
    in property <bool> enabled: true;
    callback clicked();
    height: small ? 24px : 28px;
    min-width: max(small ? 0px : 80px, label.preferred-width + (small ? 16px : 24px));
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: primary && enabled ? 0 : 1px;
    border-color: Theme.line;
    opacity: enabled ? 1 : 0.55;
    background: primary ? (touch.pressed ? Theme.accent.darker(0.15) : touch.has-hover && enabled ? Theme.accent.brighter(0.08) : Theme.accent)
        : touch.pressed && enabled ? Theme.button-pressed
        : touch.has-hover && enabled ? Theme.button-hover : Theme.button;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => {
        root.clicked();
    }
    label := Text {
        text: root.text;
        color: primary ? Theme.accent-text : danger ? Theme.danger : Theme.text;
        font-size: small ? 12px : 13px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Asks for a second click within four seconds before doing something that cannot be undone.
export component DangerButton inherits Rectangle {
    in property <string> text;
    in property <bool> small;
    callback confirmed();
    property <bool> armed;
    height: small ? 24px : 28px;
    min-width: max(80px, label.preferred-width + 24px);
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: armed ? 0 : 1px;
    border-color: touch.has-hover ? Theme.danger : Theme.line;
    background: armed ? Theme.danger
        : touch.pressed ? Theme.button-pressed
        : touch.has-hover ? Theme.danger-soft : Theme.button;
    accessible-role: button;
    accessible-label: label.text;
    label := Text {
        text: armed ? I18n.t("gui-confirm") : root.text;
        color: armed ? white : Theme.danger;
        font-size: small ? 12px : 13px;
    }

    touch := TouchArea {
        clicked => {
            if armed {
                armed = false;
                root.confirmed();
            } else {
                armed = true;
            }
        }
    }

    Timer {
        interval: 4s;
        running: armed;
        triggered => {
            armed = false;
        }
    }
}

export component Caption inherits Text {
    color: Theme.text;
    font-size: 12px;
    horizontal-alignment: I18n.rtl ? right : left;
}

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> number;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback accepted();
    callback edited(string);
    forward-focus: input;
    spacing: 4px;
    if label != "": Caption {
        text: label;
    }
    Rectangle {
        height: 28px;
        border-radius: 4px;
        background: enabled ? Theme.field : Theme.bg;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.line;
        clip: true;
        if text == "" && !input.has-focus: Text {
            x: 7px;
            width: parent.width - 14px;
            text: placeholder;
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: I18n.rtl ? right : left;
        }
        input := TextInput {
            x: 7px;
            width: parent.width - 14px;
            text <=> root.text;
            enabled: root.enabled;
            color: Theme.text;
            font-size: 13px;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-text;
            input-type: password ? InputType.password : number ? InputType.number : InputType.text;
            single-line: true;
            vertical-alignment: center;
            horizontal-alignment: I18n.rtl ? right : left;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited(self.text);
            }
        }
    }
}

// A check box with its label; named after the switch it replaced.
export component Switch inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: max(22px, label.preferred-height);
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: text;
    function flip() {
        checked = !checked;
        root.toggled(checked);
    }
    box := Rectangle {
        x: I18n.rtl ? parent.width - 16px : 0;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 3px;
        opacity: enabled ? 1 : 0.5;
        background: checked ? Theme.accent : Theme.field;
        border-width: checked ? 0 : 1px;
        border-color: touch.has-hover && enabled ? Theme.accent : Theme.line.darker(0.15);
        if checked: Icon {
            width: 12px;
            height: 12px;
            name: Icons.check;
            stroke: Theme.accent-text;
            stroke-width: 3px;
        }
    }

    label := Text {
        x: I18n.rtl ? 0 : 24px;
        width: parent.width - 24px;
        text: root.text;
        color: enabled ? Theme.text : Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: I18n.rtl ? right : left;
        wrap: word-wrap;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            flip();
        }
    }
}

export component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback selected(int);
    height: 28px;
    border-radius: 4px;
    background: touch.pressed ? Theme.button-pressed : touch.has-hover ? Theme.button-hover : Theme.button;
    border-width: 1px;
    border-color: Theme.line;
    accessible-role: combobox;
    accessible-value: current >= 0 && current < options.length ? options[current] : "";
    Text {
        x: I18n.rtl ? 28px : 8px;
        width: parent.width - 36px;
        text: current >= 0 && current < options.length ? options[current] : "";
        color: Theme.text;
        font-size: 13px;
        overflow: elide;
        horizontal-alignment: I18n.rtl ? right : left;
    }

    Icon {
        x: I18n.rtl ? 8px : parent.width - 22px;
        width: 14px;
        height: 14px;
        name: Icons.chevron;
        stroke: Theme.muted;
    }

    touch := TouchArea {
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        Rectangle {
            background: Theme.card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding: 3px;
                for option[i] in options: Rectangle {
                    height: 24px;
                    border-radius: 3px;
                    background: option-touch.has-hover ? Theme.accent : i == current ? Theme.accent-soft : transparent;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: option;
                        font-size: 13px;
                        color: option-touch.has-hover ? Theme.accent-text : Theme.text;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }

                    option-touch := TouchArea {
                        clicked => {
                            current = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

// A full-width row that opens another dialog, like a submenu.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> danger;
    in property <bool> arrow;
    callback clicked();
    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    background: touch.pressed ? Theme.button-pressed : touch.has-hover ? Theme.button-hover : Theme.button;
    accessible-role: button;
    accessible-label: text;
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: danger ? Theme.danger : Theme.text;
        font-size: 13px;
        horizontal-alignment: I18n.rtl ? right : left;
    }

    if detail != "" || arrow: HorizontalLayout {
        x: I18n.rtl ? 8px : parent.width - self.width - 8px;
        width: self.preferred-width;
        spacing: 4px;
        if detail != "" && !I18n.rtl: Text {
            text: detail;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        if arrow: VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                name: I18n.rtl ? Icons.chevron-back : Icons.chevron-forward;
                stroke: Theme.muted;
            }
        }
        if detail != "" && I18n.rtl: Text {
            text: detail;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Dot inherits Rectangle {
    in property <string> state;
    width: 8px;
    height: 8px;
    border-radius: self.width / 2;
    background: Theme.state-color(state);
}

// Four bars and the round trip next to them; the bars grow from left to right in every language.
export component Signal inherits Rectangle {
    in property <int> level;
    in property <string> ping;
    in property <string> tooltip;
    // Grays the numbers while the ping is measured again.
    in property <bool> busy;
    width: 72px;
    height: 16px;
    accessible-role: text;
    accessible-label: ping;
    for bar[i] in [1, 2, 3, 4]: Rectangle {
        x: i * 4px;
        y: parent.height - 3px - bar * 3px;
        width: 3px;
        height: 3px + bar * 3px;
        border-radius: 1px;
        background: bar > level ? Theme.line : level >= 3 ? Theme.ok : level == 2 ? Theme.warn : Theme.danger;
    }
    Text {
        x: 20px;
        width: parent.width - 20px;
        text: ping;
        color: busy ? Theme.line : Theme.muted;
        font-size: 12px;
        horizontal-alignment: left;
    }
}

export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <string> link;
    in property <image> picture;
    in property <bool> has-picture;
    // Kept for callers that used to hide the presence mark.
    in property <bool> plain;
    width: 22px;
    height: 22px;
    border-radius: self.width / 2;
    background: tint;
    if !has-picture: Text {
        text: initial;
        color: white;
        font-weight: 600;
        font-size: root.height * 0.5;
    }
    if has-picture: Rectangle {
        border-radius: self.width / 2;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: picture;
            image-fit: cover;
        }
    }
}

export component Tag inherits Text {
    in property <bool> strong;
    color: strong ? Theme.accent : Theme.muted;
    font-size: 11px;
    vertical-alignment: center;
}

// An endless progress bar for work of unknown length.
export component Spinner inherits Rectangle {
    width: 140px;
    height: 8px;
    border-radius: 4px;
    background: Theme.line-soft;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    property <float> phase: Math.mod(animation-tick() / 1ms, 1600) / 1600;
    property <float> span: root.width / 1px + 40;
    for i in [0, 1, 2, 3]: Rectangle {
        x: (Math.mod(phase * span + i * 9, span) - 40) * 1px;
        y: 0;
        width: 7px;
        height: parent.height;
        border-radius: 3px;
        background: Theme.accent;
    }
}

export component ProgressBar inherits Rectangle {
    in property <int> progress;
    height: 8px;
    border-radius: 4px;
    background: Theme.line-soft;
    Rectangle {
        x: I18n.rtl ? parent.width - self.width : 0;
        width: parent.width * max(0, min(100, progress)) / 100;
        border-radius: 4px;
        background: Theme.accent;
    }
}

// A white list in a thin frame.
export component ListBox inherits Rectangle {
    background: Theme.card;
    border-radius: 4px;
    clip: true;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 1px;
        @children
    }
}

export component Separator inherits Rectangle {
    height: 1px;
    background: Theme.line-soft;
}
