    out property <string> more: "M5 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z M12 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z M19 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z";
    out property <string> link: "M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7 M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7";
    out property <string> pulse: "M22 12h-4l-3 9L9 3l-3 9H2";
    out property <string> users: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 3a4 4 0 1 0 0 8a4 4 0 1 0 0-8z M19 8v6 M22 11h-6";
    out property <string> globe: "M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20z M2 12h20 M12 2a15 15 0 0 1 0 20a15 15 0 0 1 0-20z";
    out property <string> cloud: "M18 10h-1.3A7 7 0 1 0 9 19h9a5 5 0 0 0 0-9z";
    out property <string> monitor: "M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 21h8 M12 17v4";
    out property <string> check: "M20 6 9 17l-5-5";

    public pure function kind(name: string) -> string {
        if name == "online" {
            return globe;
        }
        if name == "local" {
            return monitor;
        }
        return cloud;
    }
}
