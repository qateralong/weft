    out property <string> image: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8.5 7a1.5 1.5 0 1 0 0 3a1.5 1.5 0 1 0 0-3z M21 15l-5-5L5 21";

    public pure function kind(name: string) -> string {
        if name == "online" {
            return globe;
        }
        if name == "local" {
            return monitor;
        }
        return cloud;
    }
}
