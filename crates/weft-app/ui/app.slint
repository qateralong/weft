// Weft main window: networks with their members, two themes, right-to-left layouts.

export struct MemberRow {
    nickname: string,
    sub: string,
    address: string,
    ping: string,
    level: int,
    link: string,
    color: color,
    initial: string,
    me: bool,
}

export struct NetworkCard {
    id: string,
    name: string,
    count: string,
    tags: [string],
    members: [MemberRow],
    collapsed: bool,
    requests: int,
    manager: bool,
}

export global I18n {
    in property <int> revision;
    in property <bool> rtl;
    pure callback translate(string) -> string;

    // Reading `revision` makes every text depend on the current language.
    public pure function t(id: string) -> string {
        return revision >= 0 ? translate(id) : "";
    }
}

export global Theme {
    in-out property <bool> dark;
    out property <color> bg: dark ? #1c1d20 : #f4efe6;
    out property <color> card: dark ? #26282c : #fffdf8;
    out property <color> hover: dark ? #2d2f34 : #faf5ec;
    out property <color> text: dark ? #e7e5e1 : #2b2620;
    out property <color> muted: dark ? #8e9096 : #8a8073;
    out property <color> line: dark ? #34363c : #e6ddcf;
    out property <color> accent: dark ? #5aa6dd : #a0612f;
    out property <color> accent-soft: dark ? #5aa6dd24 : #a0612f1f;
    out property <color> accent-text: dark ? #10161c : #ffffff;
    out property <color> danger: dark ? #e2705f : #c4513f;
    out property <color> ok: dark ? #57c27c : #3a9d5d;
    out property <color> warn: dark ? #e2a640 : #d38b22;
    out property <color> off: dark ? #5b5e65 : #bdb3a5;
    out property <color> shadow: dark ? #00000040 : #503c1e14;

    public pure function state-color(state: string) -> color {
        if state == "connected" || state == "direct" {
            return ok;
        }
        if state == "connecting" || state == "relay" {
            return warn;
        }
        return off;
    }
}

export global Icons {
    out property <string> power: "M12 3v9 M6.4 6.6a8 8 0 1 0 11.2 0";
    out property <string> sun: "M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8z M12 2v2 M12 20v2 M4.9 4.9l1.4 1.4 M17.7 17.7l1.4 1.4 M2 12h2 M20 12h2 M4.9 19.1l1.4-1.4 M17.7 6.3l1.4-1.4";
    out property <string> moon: "M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z";
    out property <string> gear: "M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z";
    out property <string> plus: "M12 5v14 M5 12h14";
    out property <string> join: "M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4 M10 17l5-5-5-5 M15 12H3";
    out property <string> chevron: "M6 9l6 6 6-6";
    out property <string> chevron-forward: "M9 6l6 6-6 6";
    out property <string> chevron-back: "M15 6l-6 6 6 6";
    out property <string> more: "M5 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z M12 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z M19 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z";
    out property <string> link: "M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7 M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7";
    out property <string> pulse: "M22 12h-4l-3 9L9 3l-3 9H2";
    out property <string> users: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 3a4 4 0 1 0 0 8a4 4 0 1 0 0-8z M19 8v6 M22 11h-6";
}

component Icon inherits Path {
    in property <string> name;
    commands: name;
    width: 18px;
    height: 18px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }
    Icon {
        name: icon;
        stroke: touch.has-hover ? Theme.text : Theme.muted;
        animate stroke { duration: 150ms; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    callback clicked();
    height: 40px;
    border-radius: 11px;
    background: primary ? (touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent) : (touch.has-hover ? Theme.hover : Theme.card);
    border-width: primary ? 0 : 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.line;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow;
    animate background, border-color { duration: 150ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if icon != "" && !I18n.rtl: VerticalLayout {
            alignment: center;
            Icon {
                name: icon;
                stroke: primary ? Theme.accent-text : Theme.text;
            }
        }
        Text {
            text: root.text;
            color: primary ? Theme.accent-text : Theme.text;
            font-weight: primary ? 650 : 450;
            font-size: 14px;
            vertical-alignment: center;
        }

        if icon != "" && I18n.rtl: VerticalLayout {
            alignment: center;
            Icon {
                name: icon;
                stroke: primary ? Theme.accent-text : Theme.text;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Dot inherits Rectangle {
    in property <string> state;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: Theme.state-color(state);
    animate background { duration: 300ms; }
}

// Four bars that grow from left to right in every language, and the round trip below them.
component Signal inherits VerticalLayout {
    in property <int> level;
    in property <string> ping;
    width: 52px;
    alignment: center;
    spacing: 2px;
    HorizontalLayout {
        alignment: center;
        spacing: 2px;
        height: 16px;
        for bar in [1, 2, 3, 4]: VerticalLayout {
            alignment: end;
            Rectangle {
                width: 4px;
                height: 4px * bar;
                border-radius: 1.5px;
                background: bar > level ? Theme.off.with-alpha(0.55) : level >= 3 ? Theme.ok : level == 2 ? Theme.warn : Theme.danger;
                animate background { duration: 300ms; }
            }
        }
    }

    Text {
        text: ping;
        color: Theme.muted;
        font-size: 11px;
        horizontal-alignment: center;
    }
}

component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <string> link;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: tint;
    Text {
        text: initial;
        color: white;
        font-weight: 700;
        font-size: 13px;
    }

    Rectangle {
        x: I18n.rtl ? -1px : parent.width - 11px;
        y: parent.height - 11px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.card;
        Dot {
            state: link;
            width: 8px;
            height: 8px;
            border-radius: 4px;
        }
    }
}

// One member: avatar, name and how they are reached, address, ping. Placed by hand so it mirrors.
component MemberLine inherits Rectangle {
    in property <MemberRow> data;
    in property <bool> manager;
    callback copy(string);
    callback menu();
    height: 52px;
    background: data.me ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }
    property <length> pad: 12px;
    property <length> menu-width: 32px;
    property <length> signal-width: 52px;
    property <length> address-width: 104px;
    property <length> name-start: pad + 32px + 10px;
    property <length> name-width: self.width - name-start - pad - menu-width - signal-width - address-width - 8px;

    function place(start: length, size: length) -> length {
        return I18n.rtl ? self.width - start - size : start;
    }

    touch := TouchArea { }

    Avatar {
        x: place(pad, 32px);
        initial: data.initial;
        tint: data.color;
        link: data.link;
    }

    VerticalLayout {
        x: place(name-start, name-width);
        width: name-width;
        alignment: center;
        spacing: 1px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: data.nickname;
                color: Theme.text;
                font-size: 14px;
                overflow: elide;
                horizontal-alignment: I18n.rtl ? right : left;
                horizontal-stretch: 1;
            }
        }

        Text {
            text: data.sub;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: I18n.rtl ? right : left;
        }
    }

    Rectangle {
        x: place(name-start + name-width + 4px, address-width);
        width: address-width;
        height: 22px;
        border-radius: 5px;
        background: address-touch.has-hover ? Theme.accent-soft : transparent;
        Text {
            text: data.address;
            color: address-touch.has-hover ? Theme.accent : Theme.text;
            font-family: "monospace";
            font-size: 12px;
        }

        address-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.copy(data.address);
            }
        }
    }

    Signal {
        x: place(root.width - pad - menu-width - signal-width, signal-width);
        level: data.level;
        ping: data.ping;
    }

    if manager && !data.me: IconButton {
        x: place(root.width - pad - 30px, 30px);
        icon: Icons.more;
        clicked => {
            root.menu();
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

component Tag inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    height: 18px;
    border-radius: 8px;
    background: strong ? Theme.accent-soft : Theme.bg;
    border-width: strong ? 0 : 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.text;
            color: strong ? Theme.accent : Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

component NetworkView inherits Rectangle {
    in property <NetworkCard> data;
    callback toggle();
    callback copy(string);
    callback invites();
    callback requests();
    callback menu();
    callback member-menu(int);
    property <length> head-height: 58px;
    property <length> body-height: data.members.length * 52px;
    height: head-height + (data.collapsed ? 0px : body-height);
    animate height { duration: 250ms; easing: ease-in-out; }
    background: Theme.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow;
    clip: true;

    head := Rectangle {
        y: 0;
        height: head-height;
        background: head-touch.has-hover ? Theme.hover : transparent;
        animate background { duration: 150ms; }
        head-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.toggle();
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            alignment: stretch;
            // Children are listed in reading order and reversed for right-to-left languages.
            if !I18n.rtl: VerticalLayout {
                alignment: center;
                Icon {
                    name: data.collapsed ? Icons.chevron-forward : Icons.chevron;
                    stroke: Theme.muted;
                }
            }
            if I18n.rtl: HorizontalLayout {
                spacing: 2px;
                padding-top: 13px;
                padding-bottom: 13px;
                IconButton {
                    icon: Icons.more;
                    clicked => {
                        root.menu();
                    }
                }

                if data.manager: IconButton {
                    icon: Icons.link;
                    clicked => {
                        root.invites();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: data.name + "  " + data.count;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 650;
                    overflow: elide;
                    horizontal-alignment: I18n.rtl ? right : left;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: I18n.rtl ? end : start;
                    for tag[i] in data.tags: Tag {
                        text: tag;
                        strong: I18n.rtl ? i == data.tags.length - 1 : i == 0;
                    }
                }
            }

            if !I18n.rtl: HorizontalLayout {
                spacing: 2px;
                padding-top: 13px;
                padding-bottom: 13px;
                if data.manager: IconButton {
                    icon: Icons.link;
                    clicked => {
                        root.invites();
                    }
                }
                IconButton {
                    icon: Icons.more;
                    clicked => {
                        root.menu();
                    }
                }
            }
            if I18n.rtl: VerticalLayout {
                alignment: center;
                Icon {
                    name: data.collapsed ? Icons.chevron-back : Icons.chevron;
                    stroke: Theme.muted;
                }
            }
        }
    }

    Rectangle {
        y: head-height;
        height: 1px;
        background: Theme.line;
    }

    for member[i] in data.members: MemberLine {
        y: head-height + 1px + i * 52px;
        width: root.width;
        data: member;
        manager: data.manager;
        copy(text) => {
            root.copy(text);
        }
        menu => {
            root.member-menu(i);
        }
    }
}

component Spinner inherits Rectangle {
    width: 44px;
    height: 12px;
    for i in [0, 1, 2]: Rectangle {
        x: i * 16px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
        opacity: 0.35 + 0.65 * Math.abs(Math.sin((animation-tick() / 1ms / 400 - i * 0.6) * 1rad));
    }
}

component Notice inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> action;
    in property <bool> busy;
    callback act();
    background: Theme.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 28px;
        spacing: 12px;
        alignment: center;
        if busy: HorizontalLayout {
            alignment: center;
            Spinner { }
        }
        Text {
            text: title;
            color: Theme.text;
            font-size: 18px;
            font-weight: 650;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if text != "": Text {
            text: root.text;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if action != "": HorizontalLayout {
            alignment: center;
            Button {
                width: 160px;
                text: action;
                primary: true;
                clicked => {
                    root.act();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> phase: "starting";
    in property <string> nickname;
    in property <string> connection: "disconnected";
    in property <string> address;
    in property <[NetworkCard]> networks;
    in property <string> problem-title;
    in property <string> problem-text;
    in property <string> problem-action;
    callback toggle-power();
    callback toggle-theme();
    callback settings();
    callback diagnostics();
    callback create-network();
    callback join-network();
    callback toggle-network(int);
    callback copy(string);
    callback fix-problem();
    callback poll-tick();

    title: "Weft";
    icon: @image-url("icon.png");
    preferred-width: 440px;
    preferred-height: 680px;
    min-width: 380px;
    min-height: 480px;
    background: Theme.bg;
    animate background { duration: 300ms; }
    default-font-size: 14px;

    VerticalLayout {
        header := Rectangle {
            height: 74px;
            background: Theme.card;
            animate background { duration: 300ms; }
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.shadow;

            HorizontalLayout {
                padding: 14px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                if !I18n.rtl && phase == "main": power := Rectangle {
                    width: 46px;
                    height: 46px;
                    border-radius: 23px;
                    background: connection == "connected" ? Theme.accent : Theme.bg;
                    border-width: connection == "connected" ? 0 : 2px;
                    border-color: connection == "connecting" ? Theme.warn : power-touch.has-hover ? Theme.accent : Theme.line;
                    animate background, border-color { duration: 250ms; }
                    Icon {
                        width: 22px;
                        height: 22px;
                        name: Icons.power;
                        stroke: connection == "connected" ? Theme.accent-text : connection == "connecting" ? Theme.warn : Theme.muted;
                    }

                    power-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-power();
                        }
                    }
                }
                if I18n.rtl: HorizontalLayout {
                    spacing: 2px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    IconButton {
                        icon: Icons.gear;
                        clicked => {
                            root.settings();
                        }
                    }

                    IconButton {
                        icon: Theme.dark ? Icons.sun : Icons.moon;
                        clicked => {
                            root.toggle-theme();
                        }
                    }

                    IconButton {
                        icon: Icons.pulse;
                        clicked => {
                            root.diagnostics();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: phase == "main" ? nickname : "Weft";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 650;
                        overflow: elide;
                        horizontal-alignment: I18n.rtl ? right : left;
                    }

                    if phase == "main": HorizontalLayout {
                        spacing: 6px;
                        alignment: I18n.rtl ? end : start;
                        VerticalLayout {
                            alignment: center;
                            Dot {
                                state: connection;
                            }
                        }

                        Text {
                            text: I18n.t("state-" + connection);
                            color: Theme.muted;
                            font-size: 12px;
                        }

                        Text {
                            text: address;
                            color: Theme.muted;
                            font-family: "monospace";
                            font-size: 12px;
                        }
                    }
                }

                if !I18n.rtl: HorizontalLayout {
                    spacing: 2px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    IconButton {
                        icon: Icons.pulse;
                        clicked => {
                            root.diagnostics();
                        }
                    }

                    IconButton {
                        icon: Theme.dark ? Icons.sun : Icons.moon;
                        clicked => {
                            root.toggle-theme();
                        }
                    }

                    IconButton {
                        icon: Icons.gear;
                        clicked => {
                            root.settings();
                        }
                    }
                }
                if I18n.rtl && phase == "main": power-rtl := Rectangle {
                    width: 46px;
                    height: 46px;
                    border-radius: 23px;
                    background: connection == "connected" ? Theme.accent : Theme.bg;
                    border-width: connection == "connected" ? 0 : 2px;
                    border-color: connection == "connecting" ? Theme.warn : Theme.line;
                    Icon {
                        width: 22px;
                        height: 22px;
                        name: Icons.power;
                        stroke: connection == "connected" ? Theme.accent-text : Theme.muted;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-power();
                        }
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding: 16px;
                padding-top: 14px;
                spacing: 12px;
                alignment: start;
                if phase == "starting": Notice {
                    title: I18n.t("gui-starting");
                    busy: true;
                }
                if phase == "problem": Notice {
                    title: problem-title;
                    text: problem-text;
                    action: problem-action;
                    act => {
                        root.fix-problem();
                    }
                }
                if phase == "main": HorizontalLayout {
                    spacing: 10px;
                    Button {
                        horizontal-stretch: 1;
                        icon: I18n.rtl ? Icons.join : Icons.plus;
                        text: I18n.rtl ? I18n.t("gui-join-network") : I18n.t("gui-create-network");
                        primary: I18n.rtl;
                        clicked => {
                            if I18n.rtl {
                                root.join-network();
                            } else {
                                root.create-network();
                            }
                        }
                    }

                    Button {
                        horizontal-stretch: 1;
                        icon: I18n.rtl ? Icons.plus : Icons.join;
                        text: I18n.rtl ? I18n.t("gui-create-network") : I18n.t("gui-join-network");
                        primary: !I18n.rtl;
                        clicked => {
                            if I18n.rtl {
                                root.create-network();
                            } else {
                                root.join-network();
                            }
                        }
                    }
                }
                if phase == "main": VerticalLayout {
                    spacing: 12px;
                    for network[i] in networks: NetworkView {
                        data: network;
                        toggle => {
                            root.toggle-network(i);
                        }
                        copy(text) => {
                            root.copy(text);
                        }
                    }
                }
                if phase == "main" && networks.length == 0: Notice {
                    title: I18n.t("gui-no-networks");
                }
            }
        }
    }
}
